rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myAdminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function isActiveAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && myAdminDoc().status == 'Active';
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isActiveAdmin());
      allow list: if isActiveAdmin();
      allow create: if false;
      allow update: if (isSignedIn() && request.auth.uid == adminId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 100);
      allow delete: if false;
    }

    match /users/{userId} {
      allow get: if isActiveAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow list: if isActiveAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.status == 'pending';
      allow update: if (isActiveAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedAt', 'updatedAt']))
        || (isSignedIn() && request.auth.uid == userId
          && request.resource.data.status == resource.data.status);
      allow delete: if isActiveAdmin();
    }
    // Fee fields are SERVER-written (POST /orders, /accept, /create-payment,
    // farmer set-fee endpoint). Clients must neither invent them at creation
    // nor change them afterwards.
    function feeFieldLocked(field) {
      return field in resource.data
        ? (field in request.resource.data && request.resource.data[field] == resource.data[field])
        : !(field in request.resource.data);
    }

    function feeFieldsLocked() {
      return feeFieldLocked('deliveryFee')
        && feeFieldLocked('feeStatus')
        && feeFieldLocked('distanceKm')
        && feeFieldLocked('adjustedDistanceKm')
        && feeFieldLocked('deliveryTier')
        && feeFieldLocked('roadFactor')
        && feeFieldLocked('tierVersion')
        && feeFieldLocked('deliveryMethod')
        && feeFieldLocked('manualFee')
        && feeFieldLocked('manualDeliveryFee')
        && feeFieldLocked('manualFeePins');
    }

    function noFeeFields() {
      return !('deliveryFee' in request.resource.data)
        && !('feeStatus' in request.resource.data)
        && !('distanceKm' in request.resource.data)
        && !('adjustedDistanceKm' in request.resource.data)
        && !('deliveryTier' in request.resource.data)
        && !('roadFactor' in request.resource.data)
        && !('tierVersion' in request.resource.data)
        && !('deliveryMethod' in request.resource.data)
        && !('manualFee' in request.resource.data)
        && !('manualDeliveryFee' in request.resource.data)
        && !('manualFeePins' in request.resource.data);
    }

    match /orders/{orderId} {
      allow get: if isActiveAdmin()
        || (isSignedIn() && (request.auth.uid == resource.data.buyerId
          || request.auth.uid == resource.data.farmerId));
      allow list: if isActiveAdmin();
      allow create: if isSignedIn()
        && request.resource.data.buyerId == request.auth.uid
        && noFeeFields();
      allow update: if (isActiveAdmin()
        || (isSignedIn() && (request.auth.uid == resource.data.buyerId
          || request.auth.uid == resource.data.farmerId)))
        && feeFieldsLocked();
      allow delete: if false;
    }

    match /addresses/{addressId} {
      // Buyer delivery addresses. Owner-only. lat/lng is the authoritative
      // delivery destination (OSRM pins); text fields are courier-only.
      allow get: if isActiveAdmin()
        || (isSignedIn() && request.auth.uid == resource.data.userId);
      // NOTE: list is signed-in-only because the app queries
      // addresses with where(userId == uid). Per-doc get/update/delete
      // still enforce owner-only above. Do not run unfiltered queries.
      allow list: if isActiveAdmin() || isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isActiveAdmin()
        || (isSignedIn() && request.auth.uid == resource.data.userId
          && request.resource.data.userId == resource.data.userId);
      allow delete: if isActiveAdmin()
        || (isSignedIn() && request.auth.uid == resource.data.userId);
    }

    match /adminActivities/{activityId} {
      allow read: if isActiveAdmin();
      allow create: if isActiveAdmin()
        && request.resource.data.adminId == request.auth.uid
        && request.resource.data.keys().hasOnly(['action', 'description', 'adminId', 'adminName', 'adminEmail', 'targetId', 'targetName', 'createdAt'])
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.action in ['login', 'logout', 'approve_registration', 'decline_registration', 'ban_user', 'unban_user', 'create_admin', 'update_profile_name', 'update_password', 'export_report', 'update_payout_account', 'admin_withdraw'];
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
